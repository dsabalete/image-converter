---
import ImageConverter from '../components/ImageConverter.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Convertidor de Imágenes</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css" />
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
    }
    .container {
      background: white;
      border-radius: 1rem;
      padding: 2.5rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }
    h1 {
      color: #2d3748;
      margin-top: 0;
      margin-bottom: 0.5rem;
      font-size: 2.5rem;
      font-weight: 700;
    }
    p.description {
      color: #718096;
      margin-top: 0;
      margin-bottom: 2rem;
      font-size: 1.1rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🖼️ Convertidor de Imágenes</h1>
    <p class="description">
      Sube una imagen y conviértela a otro formato (PNG, JPG, WebP, BMP, GIF, TIFF, AVIF)
    </p>
    <ImageConverter />
  </div>
</body>
</html>